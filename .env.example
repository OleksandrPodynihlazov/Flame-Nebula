# Copy to .env (never commit .env).

# Postgres container credentials. Use URL-safe characters in the password:
# it is embedded in the api's DATABASE_URL.
POSTGRES_USER=flame
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flame

# Host loopback port the gateway publishes (http://localhost:8090).
GATEWAY_PORT=8090

# Optional overrides (defaults in docker-compose.yml).
# Build the web with demo data instead of the real API (default false):
# VITE_USE_MOCKS=true
# Max rows per /api/hotspots(.csv) response (default 500000):
# HOTSPOTS_MAX_ROWS=500000
# Max rows per map viewport request (bbox) (default 20000):
# HOTSPOTS_BBOX_MAX_ROWS=20000

#API KEY for FIRMS data
FIRMS_MAP_KEY = 
